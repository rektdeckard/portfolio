---
import IndexLayout from "@layouts/IndexLayout.astro";

const pages = Object.keys(import.meta.glob("./*.astro")).map((path) => ({
  name: path.replace("./", "").replace(/[-_]/, " ").replace(".astro", ""),
  url: path.replace("./", "").replace(".astro", ""),
}));
---

<IndexLayout pageTitle="Experiments">
  <section class="">
    <ol>
      {
        pages.map((page, idx) => (
          <li class="odd:bg-experiment">
            <a
              class="grid-index min-h-28 no-underline outline-none focus:bg-primary focus:text-surface hover:bg-primary hover:text-surface"
              href={`/experiments/${page.url}`}
            >
              <span class="col-start-2">{`${idx + 1}`.padStart(2, "0")}</span>
              <span class="col-start-4 col-span-3 underline">{page.name}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</IndexLayout>
