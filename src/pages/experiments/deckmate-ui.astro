---
import ContentLayout from "@layouts/ContentLayout.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { ActionButton } from "@components/ActionButton.tsx";
import { Stepper } from "@components/Stepper.tsx";
import { Slider } from "@components/Slider.tsx";
---

<ContentLayout
  pageTitle="Deckmate UI"
  contentTitle="Deckmate UI"
  accentClass="bg-experiment"
  containerClass="grid-home"
>
  <TableOfContents
    headings={[
      { depth: 1, slug: "actionbutton", text: "ActionButton" },
      { depth: 1, slug: "stepper", text: "Stepper" },
      { depth: 1, slug: "slider", text: "Slider" },
    ]}
  />
  <article class="col-start-4 col-span-3 space-y-6">
    <hgroup id="top">
      <h1 class="font-bold text-xl">Deckmate UI</h1>
      <p>
        A simple UI component library created for this site, inspired by the
        lined-paper code listing printouts of the 60s and 70s, by way of a neat <a
          href="https://www.unifoundry.com/deckmate/index.html">utility</a
        > created by Paul Hardy of <a
          href="https://www.unifoundry.com/index.html">Unifoundry</a
        > for simulating this effect in PostScript.
      </p>
    </hgroup>
    <hr />
    <h2 id="actionbutton">ActionButton</h2>
    <p>
      A text-based button component that registers an optional keyboard
      shortcut.
    </p>
    <div class="flex flex-col items-start gap-2">
      <ActionButton client:load label="Randomize Parameters" key="r" />
      <ActionButton client:load label="Save GIF" key="s" />
      <ActionButton client:load label="No shortcut" />
      <ActionButton client:load label="Illegal Action" key="i" disabled />
    </div>
    <hr />
    <h2 id="stepper">Stepper</h2>
    <p>A number input with some quality-of-life improvements.</p>
    <div class="grid grid-cols-[28px_60px_28px_1fr] gap-1">
      <Stepper
        client:load
        defaultValue={5}
        min={1}
        max={20}
        id="fourier"
        name="fourier"
        label="Fourier Terms"
        class="contents"
      />
      <Stepper
        client:load
        defaultValue={1}
        min={0}
        max={10}
        step={0.1}
        precision={2}
        id="period"
        name="period"
        label="Period"
        class="contents"
      />
      <Stepper
        client:load
        defaultValue={1}
        min={-10}
        max={10}
        step={0.1}
        precision={2}
        id="color-period"
        name="color-period"
        label="Color Period"
        class="contents"
      />
      <Stepper
        client:load
        min={0}
        max={100}
        id="seed"
        name="seed"
        label="Seed"
        class="contents"
      />
    </div>
    <hr />
    <h2 id="slider">Slider</h2>
    <p>A range input with some quality-of-life improvements.</p>
    <div class="flex flex-col gap-5">
      <Slider
        client:load
        min={1}
        max={20}
        step={1}
        defaultValue={5}
        label="Fourier Terms"
        id="fourier-slider"
        name="fourier-slider"
        class="grid grid-cols-[400px_1fr] gap-1"
      />
      <Slider
        client:load
        min={0}
        max={Math.PI}
        step={0.05}
        defaultValue={2.35}
        label="Spline Reticulation"
        id="spline-reticulation-slider"
        name="spline-reticulation-slider"
        class="grid grid-cols-[400px_1fr] gap-1"
      />
    </div>
  </article>
</ContentLayout>
