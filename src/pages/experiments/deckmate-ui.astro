---
import ContentLayout from "@layouts/ContentLayout.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { ActionButton } from "@components/ActionButton.tsx";
import { RadioGroup } from "@components/RadioGroup.tsx";
import { Stepper } from "@components/Stepper.tsx";
import { Slider } from "@components/Slider.tsx";

const radioOptions = [
  { id: "radio-rota", label: "Rotational", value: "rotational" },
  { id: "radio-trans", label: "Translational", value: "translational" },
  { id: "radio-quant", label: "Quantum", value: "quantum" },
  { id: "radio-therm", label: "Thermal", value: "thermal", disabled: true },
  { id: "radio-other", label: "Other", value: "other" },
];
---

<ContentLayout
  pageTitle="Deckmate UI"
  contentTitle="Deckmate UI"
  accentClass="bg-experiment"
  containerClass="grid-home"
>
  <TableOfContents
    headings={[
      { depth: 1, slug: "colors", text: "Colors" },
      { depth: 1, slug: "actionbutton", text: "ActionButton" },
      { depth: 1, slug: "stepper", text: "Stepper" },
      { depth: 1, slug: "slider", text: "Slider" },
    ]}
  />
  <article class="col-start-4 col-span-3 space-y-6">
    <hgroup id="top">
      <h1 class="font-bold text-xl">Deckmate UI</h1>
      <p>
        A simple UI component library created for this site, inspired by the <a
          href="https://www.unifoundry.com/deckmate/index.html">Deckmate</a
        > utility for pretty-printing code listings to PostScript in a style that
        resembles the striped tractor-feed printouts of the 70s and 80s.
      </p>
    </hgroup>
    <hr />
    <h2 id="colors">Colors</h2>
    <div
      class="relative z-20 flex flex-wrap gap-4 *:size-24 *:outline *:outline-1 *:outline-dashed *:flex *:items-center *:justify-center"
    >
      <div class="bg-primary">
        <span class="uppercase text-surface">primary</span>
      </div>
      <div class="bg-secondary">
        <span class="uppercase text-surface">secondary</span>
      </div>
      <div class="bg-surface">
        <span class="uppercase">surface</span>
      </div>
      <div class="bg-home">
        <span class="uppercase">home</span>
      </div>
      <div class="bg-project">
        <span class="uppercase">project</span>
      </div>
      <div class="bg-writing">
        <span class="uppercase">writing</span>
      </div>
      <div class="bg-experiment">
        <span class="uppercase">experiment</span>
      </div>
      <div class="bg-success">
        <span class="uppercase text-surface">success</span>
      </div>
      <div class="bg-warning">
        <span class="uppercase text-surface">warning</span>
      </div>
      <div class="bg-error">
        <span class="uppercase text-surface">error</span>
      </div>
    </div>
    <hr />
    <h2 id="actionbutton">ActionButton</h2>
    <p>
      A text-based button component that registers an optional keyboard
      shortcut.
    </p>
    <div class="flex flex-col items-start gap-2">
      <ActionButton client:load label="Randomize Parameters" key="r" />
      <ActionButton client:load label="Expand horizon" key="e" />
      <ActionButton client:load label="Reconceptualize" />
      <ActionButton client:load label="Divide by zero" key="d" disabled />
    </div>
    <hr />
    <h2 id="radiogroup">RadioGroup</h2>
    <p>
      A mutually-exclusive selectable input group for small, finite sets of
      related options.
    </p>
    <div class="flex flex-col items-start gap-2">
      <RadioGroup
        client:load
        class="flex-col"
        label="Vibrational mode"
        options={radioOptions}
        defaultValue="translational"
      />
    </div>
    <hr />
    <h2 id="stepper">Stepper</h2>
    <p>A number input with some quality-of-life improvements.</p>
    <div class="grid grid-cols-[24ch_3ch_7ch_3ch] gap-1">
      <Stepper
        client:load
        defaultValue={5}
        min={1}
        max={20}
        id="dimensions"
        label="Dimensionality"
        class="contents"
      />
      <Stepper
        client:load
        defaultValue={1}
        min={0}
        max={10}
        step={0.01}
        precision={2}
        sensitivity={10}
        id="peando"
        label="Peano number"
        class="contents"
      />
      <Stepper
        client:load
        defaultValue={1}
        min={-10}
        max={10}
        step={0.1}
        precision={1}
        id="variance"
        label="Phase variance"
        class="contents"
      />
      <Stepper
        client:load
        min={0}
        max={100}
        id="mantissa"
        label="Mantissa"
        class="contents"
      />
    </div>
    <hr />
    <h2 id="slider">Slider</h2>
    <p>A range input with some quality-of-life improvements.</p>
    <div class="flex flex-col gap-5">
      <Slider
        client:load
        min={1}
        max={20}
        step={1}
        defaultValue={12}
        label="Liminality"
        id="liminality"
        class="grid grid-cols-[24ch_48ch] gap-1"
      />
      <Slider
        client:load
        min={0}
        max={Math.PI}
        step={0.05}
        defaultValue={2.35}
        label="Spline Reticulation"
        id="spline-reticulation-slider"
        class="grid grid-cols-[24ch_48ch] gap-1"
      />
      <Slider
        client:load
        min={3}
        max={11}
        disabled
        defaultValue={5}
        label="Sequestration"
        id="sequestration-slider"
        class="grid grid-cols-[24ch_48ch] gap-1"
      />
    </div>
  </article>
</ContentLayout>
