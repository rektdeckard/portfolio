---
import { getCollection, render } from "astro:content";

import ContentLayout from "@layouts/ContentLayout.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { getPostName, omitDraftEntries } from "@utils/content";
import { formatLongDate } from "@utils/datetime";

export const prerender = true;

export async function getStaticPaths() {
  const writings = await getCollection("writings", omitDraftEntries);
  return writings.map((writing) => ({
    params: { slug: writing.id },
    props: { writing },
  }));
}

const { writing: entry } = Astro.props;
const { Content, headings } = await render(entry);

const contentDate = formatLongDate(entry.data.date);
const contentLength = entry.body
  ? `${entry.body.split(/\W+/).length.toLocaleString()} words`
  : undefined;
---

<ContentLayout
  pageTitle={`Writing::${entry.id}`}
  contentTitle={entry.data.title}
  contentDate={contentDate}
  contentLength={contentLength}
  accentClass="bg-writing"
  containerClass="grid-home"
>
  <TableOfContents {headings} />
  <article class="col-start-4 col-span-3 flex flex-col gap-4 z-10">
    <hgroup id="top">
      <h1 class="font-bold text-xl">{getPostName(entry)}</h1>
      <p>
        {entry.data.title ? formatLongDate(entry.data.date) : "A daily journal"}
      </p>
    </hgroup>
    <div class="tags">
      {
        entry.data.tags?.map((tag: string) => (
          <p class="tag">
            <a href={`/writing/tags/#tag-${tag}`}>{tag}</a>
          </p>
        ))
      }
    </div>
    <Content />
  </article>
</ContentLayout>
