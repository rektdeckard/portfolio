---
import { getCollection } from "astro:content";
import IndexLayout from "@layouts/IndexLayout.astro";
import { omitDraftEntries, sortedCollectionByYear } from "@utils/content";
import { formatYearOrRange } from "@utils/datetime";

const projects = await getCollection("projects", omitDraftEntries);
const sortedProjects = sortedCollectionByYear(projects);
---

<IndexLayout pageTitle="Projects">
  <section class="">
    <ol>
      {
        sortedProjects.map((project, idx) => (
          <li class="odd:bg-project">
            <a
              class="grid-index min-h-28 no-underline outline-none focus:bg-primary focus:text-surface hover:bg-primary hover:text-surface"
              href={`/projects/${project.id}`}
            >
              <span class="col-start-2">{`${idx + 1}`.padStart(2, "0")}</span>
              <span class="col-span-2 underline">{project.data.title}</span>
              <span>{formatYearOrRange(project.data.year)}</span>
              <p>{project.data.description}</p>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</IndexLayout>
