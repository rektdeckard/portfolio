---
import { ThemeButton } from "@components/ThemeButton.tsx";
import ThemeInit from "@components/ThemeInit.astro";
import "@styles/global.css";

interface Props {
  pageTitle?: string;
  contentTitle?: string;
  contentDate?: string;
  contentLength?: string;
  containerClass?: string;
  accentClass?: string;
}

const {
  pageTitle,
  contentTitle,
  contentDate,
  contentLength,
  containerClass,
  accentClass,
} = Astro.props;
const { pathname } = Astro.url;
const segments = pathname.split("/").filter(Boolean);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>TF{pathname === "/" ? "" : `::${pageTitle}`}</title>
    <ThemeInit />
  </head>
  <body class="relative min-h-svh font-mono text-primary bg-surface">
    <div class="absolute inset-0 grid-home pointer-events-none z-10">
      <div class="border-r border-dashed"></div>
      <div class="border-r border-dashed"></div>
      <div class="border-r border-dashed"></div>
      <div class="border-r border-dashed"></div>
      <div class="border-r border-dashed"></div>
    </div>

    <header class="grid-home pt-28 pb-24 uppercase whitespace-nowrap relative">
      <div
        class:list={[
          "absolute top-28 left-0 right-0 h-[332px] -z-10",
          accentClass,
        ]}
      >
      </div>
      <nav class="col-start-2 col-span-2">
        <a href="/">Home</a> &gt; <a href={`/${segments[0]}`}>{segments[0]}</a>
      </nav>
      <span>{contentTitle ?? "Anonymous content"}</span>
      <span class="text-right">{contentDate ?? "Undated"}</span>
      <span class="text-right">{contentLength}</span>
      <ThemeButton client:load class="col-start-7 justify-self-end" />
    </header>
    <main class:list={["w-full pb-16", containerClass]}>
      <slot />
    </main>
    <footer></footer>
  </body>
</html>
