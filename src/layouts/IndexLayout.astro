---
import { ThemeButton } from "@components/ThemeButton.tsx";
import ThemeInit from "@components/ThemeInit.astro";
import "@styles/global.css";

interface Props {
  pageTitle?: string;
  class?: string;
}

const { pageTitle, class: className } = Astro.props;
const { pathname } = Astro.url;
const segments = pathname.split("/").filter(Boolean);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>TF{pathname === "/" ? "" : `::${pageTitle}`}</title>
    <ThemeInit />
  </head>
  <body class="relative min-h-svh font-mono text-primary bg-surface">
    <div class="absolute inset-0 grid-index pointer-events-none z-0">
      <div class="border-r border-dashed"></div>
      <div class="border-r border-dashed"></div>
      <div class="border-r border-dashed"></div>
      <div class="border-r border-dashed"></div>
      <div class="border-r border-dashed"></div>
      <div class="border-r border-dashed"></div>
    </div>
    <header class="grid-index pt-28 pb-24 uppercase whitespace-nowrap">
      <nav class="col-start-2 col-span-2">
        <a href="/">Home</a> &gt; {segments[0]}
      </nav>
      <span class="col-start-5 text-right">00:18:41</span>
      <span>Choose a project</span>
      <ThemeButton client:load class="col-start-8 justify-self-end" />
    </header>
    <main class="w-full pb-16">
      <slot />
    </main>
    <footer></footer>
  </body>
</html>
